# Docker Compose host ports. Copy this file to .env only when overriding defaults.
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Windows example for HTTPS-inspecting networks. See docs/public/container-development.md.
# COMPOSE_FILE=compose.yaml;compose.local-ca.yaml
# CONTAINER_CA_CERT=.certs/local-ca.crt

# Azure document indexing batch. These values are identifiers/endpoints, not secrets.
# Set them in the shell that runs backend/scripts/index_asvs_documents.py.
# Runtime search also uses these values when ASVS_SEARCH_BACKEND=azure.
# The Python application does not automatically load this file.
ASVS_SEARCH_BACKEND=csv
AZURE_OPENAI_BASE_URL=https://<foundry-account-name>.openai.azure.com/openai/v1/
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_SEARCH_ENDPOINT=https://<search-service-name>.search.windows.net
AZURE_SEARCH_INDEX_NAME=security-docs-v1

# OpenAI answer generation. OPENAI_API_KEY is a SECRET: never commit a real value.
# Required by POST /api/v1/requirements/answer.
OPENAI_API_KEY=<openai-project-api-key>
OPENAI_CHAT_MODEL=<openai-model-id>
OPENAI_CHAT_TIMEOUT_SECONDS=30
OPENAI_CHAT_MAX_COMPLETION_TOKENS=800

# Optional RAGAS evaluator overrides. When unset, evaluate_ragas.py uses OPENAI_CHAT_MODEL.
RAGAS_EVALUATOR_MODEL=<openai-model-id>
RAGAS_EVALUATOR_EMBEDDING_MODEL=text-embedding-3-small
RAGAS_EVALUATOR_TIMEOUT_SECONDS=120
RAGAS_EVALUATOR_CONCURRENCY=1

# Azure Entra ID service principal credentials. SECRETS: set them in .env, never commit real values.
# DefaultAzureCredential's EnvironmentCredential reads these automatically inside the container.
# Required only when ASVS_SEARCH_BACKEND=azure and no managed identity is available.
# The service principal needs:
#   - "Cognitive Services OpenAI User" on the Azure OpenAI/Foundry resource
#   - "Search Index Data Reader" on the Azure AI Search service (RBAC auth must be enabled)
AZURE_TENANT_ID=<tenant-id-guid>
AZURE_CLIENT_ID=<app-registration-client-id>
AZURE_CLIENT_SECRET=<client-secret-value>
